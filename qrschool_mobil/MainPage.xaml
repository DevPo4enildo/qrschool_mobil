<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="qrschool_mobil.MainPage"
             BackgroundColor="#F4F7FB"
             Title="QR School">
    <Grid RowDefinitions="Auto,*">
        <Border Grid.Row="0"
                Margin="16,16,16,8"
                Padding="20"
                StrokeShape="RoundRectangle 28"
                StrokeThickness="0"
                Background="#1B4D89">
            <VerticalStackLayout Spacing="14">
                <Label Text="QR School"
                       TextColor="White"
                       FontAttributes="Bold"
                       FontSize="32" />
                <Label Text="Мобильный журнал посещаемости с QR-сканированием и синхронизацией Neon"
                       TextColor="#D8E8FF"
                       FontSize="15" />
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                    <Border Padding="12" StrokeShape="RoundRectangle 18" BackgroundColor="#2A64A5">
                        <VerticalStackLayout>
                            <Label Text="Сегодня" TextColor="#BFD8F7" FontSize="12" />
                            <Label x:Name="PresentLabel" Text="—" TextColor="White" FontAttributes="Bold" FontSize="24" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="1" Padding="12" StrokeShape="RoundRectangle 18" BackgroundColor="#2A64A5">
                        <VerticalStackLayout>
                            <Label Text="Опоздали" TextColor="#BFD8F7" FontSize="12" />
                            <Label x:Name="LateLabel" Text="—" TextColor="White" FontAttributes="Bold" FontSize="24" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="2" Padding="12" StrokeShape="RoundRectangle 18" BackgroundColor="#2A64A5">
                        <VerticalStackLayout>
                            <Label Text="Очередь" TextColor="#BFD8F7" FontSize="12" />
                            <Label x:Name="SyncLabel" Text="—" TextColor="White" FontAttributes="Bold" FontSize="24" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>
            </VerticalStackLayout>
        </Border>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16" Spacing="16">
                <Border Padding="18" StrokeShape="RoundRectangle 24" StrokeThickness="0" BackgroundColor="White">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="Подключение к Neon" FontAttributes="Bold" FontSize="20" TextColor="#172033" />
                        <Label Text="Вставьте строку подключения Neon PostgreSQL. Если строка не задана, приложение работает в демо-режиме и сохраняет QR-отметки локально до настройки облака."
                               FontSize="13"
                               TextColor="#697386" />
                        <Entry x:Name="ConnectionStringEntry"
                               Placeholder="postgresql://user:password@host/db?sslmode=require"
                               IsPassword="True" />
                        <Button Text="Сохранить подключение" Clicked="OnSaveConnectionClicked" BackgroundColor="#1B4D89" TextColor="White" CornerRadius="16" />
                        <Label x:Name="ConnectionStatusLabel" TextColor="#697386" FontSize="13" />
                    </VerticalStackLayout>
                </Border>

                <Border Padding="18" StrokeShape="RoundRectangle 24" StrokeThickness="0" BackgroundColor="White">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="Сканер QR" FontAttributes="Bold" FontSize="20" TextColor="#172033" />
                        <Entry x:Name="QrPayloadEntry" Placeholder="student:1001" />
                        <Button Text="Отметить по QR" Clicked="OnRegisterQrClicked" BackgroundColor="#2E7D32" TextColor="White" CornerRadius="16" />
                        <Label x:Name="LastScanLabel" Text="Готов к сканированию" TextColor="#697386" />
                    </VerticalStackLayout>
                </Border>

                <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                    <Border Padding="18" StrokeShape="RoundRectangle 24" StrokeThickness="0" BackgroundColor="White">
                        <VerticalStackLayout Spacing="10">
                            <Label Text="Ученики" FontAttributes="Bold" FontSize="20" TextColor="#172033" />
                            <CollectionView x:Name="StudentsView" HeightRequest="220">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Padding="0,8" RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto">
                                            <Label Text="{Binding FullName}" FontAttributes="Bold" TextColor="#172033" />
                                            <Label Grid.Column="1" Text="{Binding ClassName}" TextColor="#1B4D89" FontAttributes="Bold" />
                                            <Label Grid.Row="1" Text="{Binding Status}" TextColor="#697386" FontSize="12" />
                                        </Grid>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </VerticalStackLayout>
                    </Border>

                    <Border Grid.Column="1" Padding="18" StrokeShape="RoundRectangle 24" StrokeThickness="0" BackgroundColor="White">
                        <VerticalStackLayout Spacing="10">
                            <Label Text="Последние отметки" FontAttributes="Bold" FontSize="20" TextColor="#172033" />
                            <CollectionView x:Name="AttendanceView" HeightRequest="220">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Padding="0,8" RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto">
                                            <Label Text="{Binding StudentName}" FontAttributes="Bold" TextColor="#172033" />
                                            <Label Grid.Column="1" Text="{Binding Source}" TextColor="#2E7D32" FontSize="12" />
                                            <Label Grid.Row="1" Text="{Binding CheckedAt, StringFormat='{0:HH:mm}'}" TextColor="#697386" FontSize="12" />
                                        </Grid>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </VerticalStackLayout>
                    </Border>
                </Grid>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
