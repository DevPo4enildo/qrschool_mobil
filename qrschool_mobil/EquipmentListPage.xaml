<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="qrschool_mobil.EquipmentListPage"
             BackgroundColor="#1F1F1F"
             Title="Список техники">
    <Grid Padding="28,24" RowDefinitions="Auto,Auto,Auto,*">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="28">
            <Label Text="‹" TextColor="White" FontSize="46" VerticalOptions="Center">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBackTapped" />
                </Label.GestureRecognizers>
            </Label>
            <Label Grid.Column="1" Text="Список техники" TextColor="White" FontSize="29" FontAttributes="Bold" VerticalOptions="Center" />
        </Grid>

        <Label Grid.Row="1" Text="Добавленная техника" TextColor="White" FontSize="34" FontAttributes="Bold" Margin="0,56,0,18" />

        <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="14">
            <Button Text="Загрузить из Excel" BackgroundColor="#A895EC" TextColor="#24202B" CornerRadius="10" HeightRequest="66" FontSize="19" />
            <Button Grid.Column="1" Text="Выгрузить в Excel" BackgroundColor="#A895EC" TextColor="#24202B" CornerRadius="10" HeightRequest="66" FontSize="19" />
        </Grid>

        <RefreshView Grid.Row="3" x:Name="RefreshHost" Refreshing="OnRefreshing" Margin="0,32,0,0">
            <CollectionView x:Name="EquipmentView" EmptyView="Пока нет добавленной техники">
                <CollectionView.EmptyViewTemplate>
                    <DataTemplate>
                        <Label Text="Пока нет добавленной техники"
                               TextColor="#7C7C7C"
                               FontSize="20"
                               HorizontalTextAlignment="Center"
                               VerticalTextAlignment="Center" />
                    </DataTemplate>
                </CollectionView.EmptyViewTemplate>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,12" Padding="16" BackgroundColor="#050505" StrokeThickness="0" StrokeShape="RoundRectangle 8">
                            <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto">
                                <Label Text="{Binding Type}" TextColor="White" FontSize="21" FontAttributes="Bold" />
                                <Label Grid.Column="1" Text="{Binding Cabinet}" TextColor="#A895EC" FontSize="18" />
                                <Label Grid.Row="1" Text="{Binding Status}" TextColor="#DADADA" FontSize="17" />
                                <Label Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding Description}" TextColor="#9D9D9D" FontSize="15" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>
